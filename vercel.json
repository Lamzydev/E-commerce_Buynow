{
  "version": 2,
  "installCommand": "npm install --prefix ecommerceProject",
  "buildCommand": "npm --prefix ecommerceProject run build",
  "builds": [
    {
      "src": "ecommerceProject/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
